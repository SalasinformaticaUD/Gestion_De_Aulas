# URL pública de la API de Gestión de Aulas.
NEXT_PUBLIC_AULAS_API_URL="http://localhost:3000"

# URL pública de la API de Gestión de Monitores.
NEXT_PUBLIC_MONITORES_API_URL="http://localhost:8000"

# Las dos URL anteriores se consumen mediante el proxy interno de Next.js para
# conservar cookies de sesión, CSRF y evitar dependencias de CORS en el navegador.
