DATABASE_URL=postgresql://usuario:password@localhost:5432/aulas
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=28800
# Compatibilidad con la autenticacion existente.
AUTH_TOKEN_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_REQUIRED=false
PERMISSIONS_MODE=strict
MONITORES_API_URL=http://localhost:8000
MONITORES_API_TIMEOUT_MS=5000
MONITORES_SERVICE_TOKEN=cambiar-por-un-secreto-de-servicio-largo-y-unico
# Clave aleatoria exclusiva para cifrar credenciales operativas (mínimo 32 caracteres).
CREDENTIALS_ENCRYPTION_KEY=cambiar-por-una-clave-aleatoria-larga-y-unica
# Servicio interno FastAPI para rellenar XLSX y convertir a PDF.
PDF_RENDERER_URL=http://127.0.0.1:8001
PDF_RENDERER_TIMEOUT_MS=120000
SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# Webhook compatible con el proveedor de correo transaccional.
EMAIL_WEBHOOK_URL=
# Se exige al ejecutar el seed para crear el administrador inicial.
ADMIN_INITIAL_PASSWORD=ClaveSegura123456789

# Docker Compose: estas variables viven en el mismo .env. Reemplace todos los
# valores CHANGE_ME antes de iniciar el entorno de staging.
COMPOSE_PROJECT_NAME=aulas
IMAGE_TAG=latest
POSTGRES_DB=aulas
POSTGRES_USER=aulas
POSTGRES_PASSWORD=CHANGE_ME_database_password
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=3001
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_PUBLIC_URL=http://localhost:3001
AULAS_API_INTERNAL_URL=http://backend:3000
# Dirección que Docker usa para alcanzar Gestión de Monitores. Mantenga
# MONITORES_API_URL para desarrollo local y use esta al ejecutar Compose.
MONITORES_DOCKER_API_URL=http://host.docker.internal:8000
RUN_DATABASE_SEED=true
