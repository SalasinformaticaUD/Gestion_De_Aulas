// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EstadoCuenta {
  ACTIVA
  INACTIVA
  BLOQUEADA
}

enum EstadoAula {
  OPERATIVA
  MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum EstadoAsistencia {
  PENDIENTE
  ASISTIO
  AUSENTE
}

enum EstadoPrestamo {
  SOLICITADO
  APROBADO
  ACTIVO
  DEVUELTO
  DEVUELTO_INCOMPLETO
  CANCELADO
  VENCIDO
}

enum EstadoEquipo {
  DISPONIBLE
  PRESTADO
  MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum EstadoMulta {
  ACTIVA
  CUMPLIDA
  ANULADA
}

enum EstadoTarea {
  PENDIENTE
  EN_PROCESO
  SUSPENDIDA
  COMPLETADA
  RECHAZADA
  CANCELADA
}

enum PrioridadTarea {
  CRITICA
  ALTA
  MEDIA
  BAJA
}

enum DecisionTarea {
  ACEPTADA
  RECHAZADA
}

enum EstadoCredencial {
  ACTIVA
  INACTIVA
  PENDIENTE_ACTUALIZACION
  FUERA_DE_USO
}

enum TipoObservacion {
  GENERAL
  NOVEDAD
  RESTRICCION
}

enum ResultadoImportacionSoftware {
  EXITOSA
  PARCIAL
  FALLIDA
}

enum EstadoSoftware {
  ACTIVO
  SIN_LICENCIA
  LICENCIADO
  EN_REVISION
  INACTIVO
}

enum EstadoLimpieza {
  REALIZADA
  NOVEDAD
}

// Identidad, autorización y auditoría
model Usuario {
  id                               String                      @id @default(uuid()) @db.Uuid
  nombreCompleto                   String
  nombreUsuario                    String                      @unique
  correo                           String                      @unique
  passwordHash                     String
  cargo                            String?
  estado                           EstadoCuenta                @default(ACTIVA)
  dependenciaId                    String?                     @db.Uuid
  dependencia                      Dependencia?                @relation(fields: [dependenciaId], references: [id])
  roles                            UsuarioRol[]
  asistencias                      AsistenciaDocente[]         @relation("RegistroAsistencia")
  tareasAsignadas                  Tarea[]                     @relation("ResponsableTarea")
  tareasOperativasCreadas          Tarea[]                     @relation("CreadorTareaOperativa")
  tareasOperativasCanceladas       Tarea[]                     @relation("CanceladorTareaOperativa")
  decisionesTarea                  DecisionTareaOperativa[]    @relation("DecisionTareaUsuario")
  informesTarea                    InformeSeguimientoTarea[]   @relation("InformeTareaUsuario")
  observacionesCreadas             Observacion[]               @relation("AutorObservacion")
  responsabilidadesTarea           ResponsableTareaOperativa[] @relation("ResponsableOperativoUsuario")
  responsablesTareaAgregados       ResponsableTareaOperativa[] @relation("ResponsableOperativoAgregadoPor")
  auditorias                       Auditoria[]
  accesosCredencial                AccesoCredencial[]
  secretosCredencial               SecretoCredencial[]
  prestamosAudiovisualesEntregados PrestamoAudiovisual[]       @relation("EntregaPrestamoAudiovisual")
  prestamosAudiovisualesRecibidos  PrestamoAudiovisual[]       @relation("RecepcionPrestamoAudiovisual")
  prestamosAudiovisualesCancelados PrestamoAudiovisual[]       @relation("CancelacionPrestamoAudiovisual")
  importacionesSoftware            ImportacionSoftware[]
  multasImpuestas                  Multa[]                     @relation("MultaImpuestaPor")
  multasCumplidas                  Multa[]                     @relation("MultaCumplidaPor")
  multasAnuladas                   Multa[]                     @relation("MultaAnuladaPor")
  prestamosDocentesCreados         PrestamoDocente[]           @relation("PrestamoDocenteEncargado")
  limpiezasRegistradas             Limpieza[]                  @relation("RegistroLimpieza")
  creadoEn                         DateTime                    @default(now())
  actualizadoEn                    DateTime                    @updatedAt
}

model Dependencia {
  id       String    @id @default(uuid()) @db.Uuid
  nombre   String    @unique
  activa   Boolean   @default(true)
  usuarios Usuario[]
}

model Cargo {
  id            String   @id @default(uuid()) @db.Uuid
  nombre        String   @unique
  descripcion   String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model Rol {
  id                      String          @id @default(uuid()) @db.Uuid
  nombre                  String          @unique
  descripcion             String?
  usuarios                UsuarioRol[]
  permisos                RolPermiso[]
  credencialesAutorizadas CredencialRol[]
}

model Permiso {
  id          String       @id @default(uuid()) @db.Uuid
  codigo      String       @unique
  descripcion String?
  moduloId    String       @db.Uuid
  modulo      Modulo       @relation(fields: [moduloId], references: [id])
  roles       RolPermiso[]
}

model Modulo {
  id       String    @id @default(uuid()) @db.Uuid
  codigo   String    @unique
  nombre   String
  activo   Boolean   @default(true)
  permisos Permiso[]
}

model UsuarioRol {
  usuarioId String  @db.Uuid
  rolId     String  @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
}

model RolPermiso {
  rolId     String  @db.Uuid
  permisoId String  @db.Uuid
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
}

model Auditoria {
  id           String   @id @default(uuid()) @db.Uuid
  usuarioId    String?  @db.Uuid
  usuario      Usuario? @relation(fields: [usuarioId], references: [id])
  entidad      String
  entidadId    String
  accion       String
  datosPrevios Json?
  datosNuevos  Json?
  creadoEn     DateTime @default(now())

  @@index([entidad, entidadId])
}

// Catálogos académicos y aulas
model Aula {
  id                     String                   @id @default(uuid()) @db.Uuid
  codigo                 String                   @unique
  ubicacion              String
  capacidad              Int
  caracteristicas        Json?
  estado                 EstadoAula               @default(OPERATIVA)
  anioAdquisicion        Int?
  marca                  String?
  modelo                 String?
  renovacionTecnologica  Boolean                  @default(false)
  pendienteIntervencion  Boolean                  @default(false)
  proyectoCurricularId   String?                  @db.Uuid
  proyectoCurricular     ProyectoCurricular?      @relation(fields: [proyectoCurricularId], references: [id])
  proyectosCurriculares  AulaProyectoCurricular[]
  softwares              AulaSoftware[]
  clases                 ClaseProgramada[]
  practicasLibres        PracticaLibre[]
  prestamosDocentes      PrestamoDocente[]
  prestamosAudiovisuales PrestamoAudiovisual[]
  observaciones          Observacion[]
  tareas                 Tarea[]
  limpiezas              Limpieza[]
  eliminadoEn            DateTime?
  creadoEn               DateTime                 @default(now())
  actualizadoEn          DateTime                 @updatedAt
}

model PeriodoAcademico {
  id          String            @id @default(uuid()) @db.Uuid
  nombre      String            @unique
  fechaInicio DateTime
  fechaFin    DateTime
  activo      Boolean           @default(false)
  clases      ClaseProgramada[]
}

model ProyectoCurricular {
  id             String                   @id @default(uuid()) @db.Uuid
  nombre         String                   @unique
  aulas          Aula[]
  aulasAsignadas AulaProyectoCurricular[]
  asignaturas    Asignatura[]
  clases         ClaseProgramada[]
}

model AulaProyectoCurricular {
  aulaId               String             @db.Uuid
  proyectoCurricularId String             @db.Uuid
  aula                 Aula               @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  proyectoCurricular   ProyectoCurricular @relation(fields: [proyectoCurricularId], references: [id], onDelete: Cascade)

  @@id([aulaId, proyectoCurricularId])
  @@index([proyectoCurricularId])
}

model Asignatura {
  id                   String              @id @default(uuid()) @db.Uuid
  codigo               String              @unique
  nombre               String
  proyectoCurricularId String?             @db.Uuid
  proyectoCurricular   ProyectoCurricular? @relation(fields: [proyectoCurricularId], references: [id])
  clases               ClaseProgramada[]
}

model Docente {
  id                     String                @id @default(uuid()) @db.Uuid
  documento              String?               @unique
  nombre                 String
  correo                 String?               @unique
  proyecto               String?
  clases                 ClaseProgramada[]
  prestamos              PrestamoDocente[]
  practicasLibres        PracticaLibre[]
  prestamosAudiovisuales PrestamoAudiovisual[]
}

model ClaseProgramada {
  id                   String              @id @default(uuid()) @db.Uuid
  periodoId            String              @db.Uuid
  aulaId               String              @db.Uuid
  docenteId            String              @db.Uuid
  asignaturaId         String              @db.Uuid
  proyectoCurricularId String?             @db.Uuid
  diaSemana            Int
  semana               Int                 @default(1)
  horaInicio           DateTime            @db.Time(0)
  horaFin              DateTime            @db.Time(0)
  grupo                String
  inscritos            Int?
  modeloPc             String?
  software             String?
  hardware             String?
  periodo              PeriodoAcademico    @relation(fields: [periodoId], references: [id])
  aula                 Aula                @relation(fields: [aulaId], references: [id])
  docente              Docente             @relation(fields: [docenteId], references: [id])
  asignatura           Asignatura          @relation(fields: [asignaturaId], references: [id])
  proyectoCurricular   ProyectoCurricular? @relation(fields: [proyectoCurricularId], references: [id])
  asistencias          AsistenciaDocente[]

  @@index([periodoId, aulaId, diaSemana])
  @@index([periodoId, diaSemana, horaInicio])
}

model AsistenciaDocente {
  id              String           @id @default(uuid()) @db.Uuid
  claseId         String           @db.Uuid
  fecha           DateTime         @default(now()) @db.Date
  registradoPorId String?          @db.Uuid
  estado          EstadoAsistencia @default(PENDIENTE)
  registradaEn    DateTime?
  observacion     String?
  clase           ClaseProgramada  @relation(fields: [claseId], references: [id])
  registradoPor   Usuario?         @relation("RegistroAsistencia", fields: [registradoPorId], references: [id])

  @@unique([claseId, fecha])
  @@index([fecha, estado])
}

model Software {
  id          String         @id @default(uuid()) @db.Uuid
  nombre      String
  version     String
  descripcion String?
  estado      EstadoSoftware @default(ACTIVO)
  aulas       AulaSoftware[]

  @@unique([nombre, version])
}

model AulaSoftware {
  aulaId      String   @db.Uuid
  softwareId  String   @db.Uuid
  instaladoEn DateTime @default(now())
  aula        Aula     @relation(fields: [aulaId], references: [id], onDelete: Cascade)
  software    Software @relation(fields: [softwareId], references: [id], onDelete: Cascade)

  @@id([aulaId, softwareId])
  @@index([softwareId])
}

model ImportacionSoftware {
  id                  String                       @id @default(uuid()) @db.Uuid
  usuarioId           String?                      @db.Uuid
  nombreArchivo       String?
  totalRegistros      Int
  registrosProcesados Int
  registrosConError   Int
  resultado           ResultadoImportacionSoftware
  errores             Json?
  usuario             Usuario?                     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  creadoEn            DateTime                     @default(now())

  @@index([creadoEn])
  @@index([usuarioId, creadoEn])
}

// Usuarios externos, préstamos y sanciones
model Estudiante {
  id        String          @id @default(uuid()) @db.Uuid
  codigo    String          @unique
  nombre    String
  correo    String?
  practicas PracticaLibre[]
  multas    Multa[]
}

model PracticaLibre {
  id                 String         @id @default(uuid()) @db.Uuid
  estudianteId       String?        @db.Uuid
  docenteId          String?        @db.Uuid
  grupoId            String?        @db.Uuid
  aulaId             String         @db.Uuid
  responsableTipo    String         @default("ASISTENCIAL")
  softwareSolicitado String?
  inicio             DateTime
  finEstimada        DateTime?
  finReal            DateTime?
  estado             EstadoPrestamo @default(ACTIVO)
  estudiante         Estudiante?    @relation(fields: [estudianteId], references: [id])
  docente            Docente?       @relation(fields: [docenteId], references: [id])
  aula               Aula           @relation(fields: [aulaId], references: [id])

  @@index([aulaId, inicio])
  @@index([grupoId])
}

model PrestamoDocente {
  id          String         @id @default(uuid()) @db.Uuid
  docenteId   String         @db.Uuid
  aulaId      String         @db.Uuid
  encargadoId String?        @db.Uuid
  inicio      DateTime
  fin         DateTime
  estado      EstadoPrestamo @default(SOLICITADO)
  motivo      String?
  docente     Docente        @relation(fields: [docenteId], references: [id])
  aula        Aula           @relation(fields: [aulaId], references: [id])
  encargado   Usuario?       @relation("PrestamoDocenteEncargado", fields: [encargadoId], references: [id])

  @@index([aulaId, inicio, fin])
  @@index([encargadoId])
}

model EquipoAudiovisual {
  id               String                           @id @default(uuid()) @db.Uuid
  codigoInventario String                           @unique
  nombre           String
  tipo             String
  marca            String?
  modelo           String?
  estado           EstadoEquipo                     @default(DISPONIBLE)
  observacion      String?
  detallesPrestamo DetallePrestamoAudiovisual[]
  mantenimientos   MantenimientoEquipoAudiovisual[]
  observaciones    ObservacionEquipoAudiovisual[]

  @@index([estado, tipo])
}

model PrestamoAudiovisual {
  id                      String                       @id @default(uuid()) @db.Uuid
  docenteId               String?                      @db.Uuid
  aulaId                  String?                      @db.Uuid
  responsableTipo         String
  docenteNombre           String
  docenteDocumento        String
  salonTexto              String
  elementosAdicionales    Json?
  observacionesPrestamo   String?
  recibidoPorTipo         String?
  observacionesDevolucion String?
  devolucionCompleta      Boolean?
  entregadoPorId          String?                      @db.Uuid
  recibidoPorId           String?                      @db.Uuid
  canceladoPorId          String?                      @db.Uuid
  salidaEn                DateTime?
  devolucionEstimada      DateTime
  devolucionReal          DateTime?
  canceladoEn             DateTime?
  motivoCancelacion       String?
  estado                  EstadoPrestamo               @default(SOLICITADO)
  docente                 Docente?                     @relation(fields: [docenteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  aula                    Aula?                        @relation(fields: [aulaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  entregadoPor            Usuario?                     @relation("EntregaPrestamoAudiovisual", fields: [entregadoPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recibidoPor             Usuario?                     @relation("RecepcionPrestamoAudiovisual", fields: [recibidoPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  canceladoPor            Usuario?                     @relation("CancelacionPrestamoAudiovisual", fields: [canceladoPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  detalles                DetallePrestamoAudiovisual[]

  @@index([estado, salidaEn])
  @@index([docenteId, salidaEn])
  @@index([aulaId, salidaEn])
}

model DetallePrestamoAudiovisual {
  prestamoId                String              @db.Uuid
  equipoId                  String              @db.Uuid
  estadoFisicoSalida        String?
  estadoFuncionalSalida     String?
  estadoFisicoDevolucion    String?
  estadoFuncionalDevolucion String?
  prestamo                  PrestamoAudiovisual @relation(fields: [prestamoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  equipo                    EquipoAudiovisual   @relation(fields: [equipoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([prestamoId, equipoId])
  @@index([equipoId])
}

model MantenimientoEquipoAudiovisual {
  id          String            @id @default(uuid()) @db.Uuid
  equipoId    String            @db.Uuid
  inicioEn    DateTime
  finEn       DateTime?
  observacion String?
  equipo      EquipoAudiovisual @relation(fields: [equipoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([equipoId, inicioEn])
}

model ObservacionEquipoAudiovisual {
  id        String            @id @default(uuid()) @db.Uuid
  equipoId  String            @db.Uuid
  contenido String
  creadoEn  DateTime          @default(now())
  equipo    EquipoAudiovisual @relation(fields: [equipoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([equipoId, creadoEn])
}

model MotivoMulta {
  id          String  @id @default(uuid()) @db.Uuid
  nombre      String  @unique
  descripcion String?
  multas      Multa[]
}

model Multa {
  id                  String      @id @default(uuid()) @db.Uuid
  estudianteId        String      @db.Uuid
  motivoId            String      @db.Uuid
  estado              EstadoMulta @default(ACTIVA)
  fecha               DateTime    @default(now())
  descripcion         String?
  multaSugerida       String?
  impuestaPorId       String?     @db.Uuid
  cumplidaEn          DateTime?
  cumplidaPorId       String?     @db.Uuid
  elementosEntregados String?
  anuladaEn           DateTime?
  anuladaPorId        String?     @db.Uuid
  motivoAnulacion     String?
  estudiante          Estudiante  @relation(fields: [estudianteId], references: [id])
  motivo              MotivoMulta @relation(fields: [motivoId], references: [id])
  impuestaPor         Usuario?    @relation("MultaImpuestaPor", fields: [impuestaPorId], references: [id], onDelete: SetNull)
  cumplidaPor         Usuario?    @relation("MultaCumplidaPor", fields: [cumplidaPorId], references: [id], onDelete: SetNull)
  anuladaPor          Usuario?    @relation("MultaAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: SetNull)

  @@index([estudianteId, estado])
  @@index([motivoId, fecha])
}

// Operación diaria y credenciales institucionales
model Observacion {
  id           String          @id @default(uuid()) @db.Uuid
  aulaId       String          @db.Uuid
  autorId      String?         @db.Uuid
  tipo         TipoObservacion @default(GENERAL)
  contenido    String
  vigenteDesde DateTime?
  vigenteHasta DateTime?
  aula         Aula            @relation(fields: [aulaId], references: [id])
  autor        Usuario?        @relation("AutorObservacion", fields: [autorId], references: [id], onDelete: SetNull)
  creadoEn     DateTime        @default(now())

  @@index([autorId, creadoEn])
  @@index([aulaId, tipo, vigenteDesde, vigenteHasta])
}

model Tarea {
  id                     String                      @id @default(uuid()) @db.Uuid
  aulaId                 String?                     @db.Uuid
  grupoId                String?                     @db.Uuid
  responsableId          String?                     @db.Uuid
  creadorId              String?                     @db.Uuid
  canceladaPorId         String?                     @db.Uuid
  titulo                 String
  descripcion            String?
  tipo                   String                      @default("OTRA")
  prioridad              PrioridadTarea              @default(MEDIA)
  estado                 EstadoTarea                 @default(PENDIENTE)
  afectaDisponibilidad   Boolean                     @default(false)
  inicio                 DateTime?
  fin                    DateTime?
  observaciones          String?
  completadaEn           DateTime?
  canceladaEn            DateTime?
  motivoCancelacion      String?
  estadoAntesCancelacion EstadoTarea?
  creadoEn               DateTime                    @default(now())
  actualizadoEn          DateTime                    @updatedAt
  aula                   Aula?                       @relation(fields: [aulaId], references: [id])
  responsable            Usuario?                    @relation("ResponsableTarea", fields: [responsableId], references: [id])
  creador                Usuario?                    @relation("CreadorTareaOperativa", fields: [creadorId], references: [id], onDelete: SetNull)
  canceladaPor           Usuario?                    @relation("CanceladorTareaOperativa", fields: [canceladaPorId], references: [id], onDelete: SetNull)
  decisiones             DecisionTareaOperativa[]
  informes               InformeSeguimientoTarea[]
  responsables           ResponsableTareaOperativa[]

  @@index([aulaId, inicio, fin])
  @@index([grupoId, creadoEn])
  @@index([responsableId, estado])
  @@index([creadorId, estado])
  @@index([canceladaPorId])
}

model ResponsableTareaOperativa {
  id            String   @id @default(uuid()) @db.Uuid
  tareaId       String   @db.Uuid
  usuarioId     String   @db.Uuid
  agregadoPorId String   @db.Uuid
  agregadoEn    DateTime @default(now())
  tarea         Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  usuario       Usuario  @relation("ResponsableOperativoUsuario", fields: [usuarioId], references: [id])
  agregadoPor   Usuario  @relation("ResponsableOperativoAgregadoPor", fields: [agregadoPorId], references: [id])

  @@unique([tareaId, usuarioId])
  @@index([usuarioId, agregadoEn])
}

model DecisionTareaOperativa {
  id            String        @id @default(uuid()) @db.Uuid
  tareaId       String        @db.Uuid
  usuarioId     String        @db.Uuid
  decision      DecisionTarea
  participantes Json?
  tomadaEn      DateTime      @default(now())
  tarea         Tarea         @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  usuario       Usuario       @relation("DecisionTareaUsuario", fields: [usuarioId], references: [id])

  @@index([tareaId, tomadaEn])
}

model InformeSeguimientoTarea {
  id                    String   @id @default(uuid()) @db.Uuid
  tareaId               String   @db.Uuid
  autorId               String   @db.Uuid
  actividadesRealizadas String
  accionesPendientes    String?
  responsables          Json?
  creadoEn              DateTime @default(now())
  tarea                 Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  autor                 Usuario  @relation("InformeTareaUsuario", fields: [autorId], references: [id])

  @@index([tareaId, creadoEn])
}

model Limpieza {
  id            String         @id @default(uuid()) @db.Uuid
  aulaId        String         @db.Uuid
  responsableId String?        @db.Uuid
  realizadaEn   DateTime       @default(now())
  estado        EstadoLimpieza @default(REALIZADA)
  observacion   String?
  aula          Aula           @relation(fields: [aulaId], references: [id])
  responsable   Usuario?       @relation("RegistroLimpieza", fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([aulaId, realizadaEn])
  @@index([realizadaEn])
  @@index([responsableId])
}

model CredencialOperativa {
  id               String              @id @default(uuid()) @db.Uuid
  nombre           String
  usuario          String?
  secretoCifrado   String?
  descripcion      String?
  estado           EstadoCredencial    @default(ACTIVA)
  accesos          AccesoCredencial[]
  secretos         SecretoCredencial[]
  rolesAutorizados CredencialRol[]
  creadoEn         DateTime            @default(now())
  actualizadoEn    DateTime            @updatedAt
}

model CredencialRol {
  credencialId String              @db.Uuid
  rolId        String              @db.Uuid
  credencial   CredencialOperativa @relation(fields: [credencialId], references: [id], onDelete: Cascade)
  rol          Rol                 @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([credencialId, rolId])
}

model AccesoCredencial {
  credencialId String              @db.Uuid
  usuarioId    String              @db.Uuid
  puedeVer     Boolean             @default(false)
  puedeEditar  Boolean             @default(false)
  credencial   CredencialOperativa @relation(fields: [credencialId], references: [id], onDelete: Cascade)
  usuario      Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([credencialId, usuarioId])
}

model SecretoCredencial {
  id             String              @id @default(uuid()) @db.Uuid
  credencialId   String              @db.Uuid
  usuarioId      String              @db.Uuid
  secretoCifrado String
  credencial     CredencialOperativa @relation(fields: [credencialId], references: [id], onDelete: Cascade)
  usuario        Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadoEn       DateTime            @default(now())
  actualizadoEn  DateTime            @updatedAt

  @@unique([credencialId, usuarioId])
  @@index([usuarioId])
}
