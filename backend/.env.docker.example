# Copie este archivo como .env.docker y reemplace todos los valores CHANGE_ME.
COMPOSE_PROJECT_NAME=aulas
IMAGE_TAG=latest

POSTGRES_DB=aulas
POSTGRES_USER=aulas
# Use caracteres URL-safe o codifique el valor también dentro de DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_database_password
POSTGRES_HOST_PORT=5433

BACKEND_HOST_PORT=3000
FRONTEND_HOST_PORT=3001
FRONTEND_PUBLIC_URL=http://localhost:3001

JWT_SECRET=CHANGE_ME_random_jwt_secret_at_least_32_chars
JWT_EXPIRES_IN=8h
AUTH_REQUIRED=true
PERMISSIONS_MODE=strict
MONITORES_SERVICE_TOKEN=CHANGE_ME_random_service_token_at_least_32_chars
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_random_encryption_key_at_least_32_chars

# Solo debe ser true durante la primera instalación. El seed crea o actualiza admin.
RUN_DATABASE_SEED=true
ADMIN_INITIAL_PASSWORD=CHANGE_ME_initial_admin_password

# El backend de Monitores no está incluido en este repositorio. Esta URL debe ser
# alcanzable desde los contenedores. En desarrollo local puede ejecutarse en el host.
MONITORES_API_URL=http://host.docker.internal:8000
MONITORES_API_TIMEOUT_MS=5000
PDF_RENDERER_TIMEOUT_MS=120000
